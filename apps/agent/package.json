{
  "name": "@errand/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:kite": "tsx --env-file-if-exists=../../.env scripts/spike-kite.ts",
    "spike:reppo": "tsx --env-file-if-exists=../../.env scripts/spike-reppo.ts",
    "evidence": "tsx --env-file-if-exists=../../.env scripts/evidence.ts",
    "benchmark": "tsx --env-file-if-exists=../../.env scripts/benchmark.ts"
  },
  "dependencies": {
    "@errand/core": "workspace:*",
    "@hono/node-server": "1.19.18",
    "hono": "4.13.16",
    "openai": "5.23.2",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
