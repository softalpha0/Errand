{
  "name": "@errand/guard-celo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Errand Guard on Celo: an x402 service where Self Agent ID decides which agents get served and how often.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@errand/celo": "workspace:*",
    "@hono/node-server": "1.19.18",
    "@selfxyz/agent-sdk": "0.3.1",
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "@x402/extensions": "2.32.0",
    "@x402/hono": "2.32.0",
    "hono": "4.13.16",
    "tsx": "4.23.15",
    "viem": "2.58.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
