# Errand Guard: x402 service on the Kite chain, built on kite-x402-hono (same variables as Kite's official templates).
# Copy to .env. Never commit .env.

# Kite wallet that receives payments (`kpass wallet address`, the "kite" row).
PAY_TO=0xYourKiteWalletAddress

# testnet (free pieUSD, for testing with `kpass sandbox on`) or mainnet (USDC.e)
KITE_NETWORK=testnet

# The Errand agent's public origin. POST /v1/check on this service -> POST {UPSTREAM_URL}/check.
UPSTREAM_URL=https://your-errand-agent.onrender.com
# Shared secret so only this wrapper (after payment) can call the agent's /check.
# Set the same value as GUARD_SERVICE_TOKEN on the Errand agent.
UPSTREAM_AUTH_HEADER=x-guard-token
UPSTREAM_AUTH_VALUE=change-me-to-a-long-random-string

# Price per check in USD.
PRICE_USD=0.01
SERVICE_DESCRIPTION=Errand Guard: should your agent make this payment? Rules plus a SERV Reasoning guard graph answer approve, ask or block with a reason.

PORT=8080
# FACILITATOR_URL=https://facilitator.pieverse.io/v2
