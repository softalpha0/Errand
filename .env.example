# Copy to .env and fill in. Never commit .env.
# The agent reads this file in development (pnpm dev). On Render/Vercel, set the same names in the dashboard.

# ---------- Agent ----------
# demo = payments and seller responses simulated (and labelled). live = real payments through Kite Passport.
ERRAND_MODE=demo
PORT=8787
# Where the web app runs (comma-separated if several). Used for CORS and receipt links in emails.
WEB_ORIGIN=http://localhost:3000
# Optional: in live mode, require this code to start an errand (strangers can't spend your money).
ERRAND_ACCESS_CODE=
DEFAULT_COUNTRY=NG
# Most one errand may spend. Amazon orders need at least the price cap + $1 Kite fee.
MAX_BUDGET_USD=10

# ---------- SERV Reasoning (console.openserv.ai) ----------
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_PLAN_MODEL=gpt-5.4-mini-serv-kronos
SERV_MODEL=gpt-5.4-mini
# gr_ id of the guard graph you generate from docs/serv-guard-graph.md. Empty = Shadow Agent fallback.
SERV_GUARD_GRAPH_ID=
# A readable label for the guard version (shown on receipts and the Results page), e.g. guard-v1, guard-v2.
SERV_GUARD_VERSION=

# ---------- Kite Passport ----------
# Path to kpass if it is not on PATH (Windows: C:\Users\you\.kpass\bin\kpass.exe)
KPASS_BIN=kpass
# Folder whose .kite-passport/ holds your login. Defaults to your home folder.
KPASS_WORKDIR=
KITE_SESSION_TTL=1h
# Each person who connects their own Passport gets a folder here holding only their login.
PASSPORTS_DIR=
# The --type Errand registers itself with on each person's Passport (kpass agent:register).
KITE_AGENT_TYPE=errand
# How often the agent looks for standing errands that are due (ms).
STANDING_POLL_MS=60000

# ---------- Reppo (eval.reppo.xyz -> API Key) ----------
REPPO_API_KEY=
REPPO_BASE_URL=https://eval.reppo.xyz/api/v1
REPPO_ENABLED=true
# Each evaluation costs 440 of your Reppo credits (sign-up gives 22,000) and settles in 30-90 seconds.
# Errand pays from these credits, so second opinions and grades cost the user nothing.
# How often the grading worker checks Reppo (ms).
REPPO_POLL_MS=10000

# ---------- Dolphin (app.dphn.ai -> API Keys) ----------
# Optional. Writes the wording of the emails Errand sends, on an open-source model. Makes no decisions.
DOLPHIN_API_KEY=
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# ---------- Errand Guard on Kite (kite-service/errand-guard) ----------
# Shared secret the paid x402 wrapper sends to this agent's POST /check. Empty = /check disabled.
GUARD_SERVICE_TOKEN=

# ---------- Telegram (optional front end) ----------
# Create a bot with @BotFather and paste its token. Empty = no bot.
TELEGRAM_BOT_TOKEN=
# Anyone who links their own Kite Passport (Connect page -> Link Telegram) can use the bot and pays from their own wallet.
# This list is only who may use Errand's OWN wallet (Telegram ids or @usernames, comma-separated). Demo mode + empty = everyone.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_BUDGET_USD=1
# 0 = same as the budget.
TELEGRAM_MAX_PER_PAYMENT_USD=0

# ---------- Storage ----------
# Postgres (e.g. Neon). Empty = in-memory (fine for local dev; lost on restart).
DATABASE_URL=

# ---------- Web (apps/web) ----------
# Public: baked into the web build. Point it at the agent.
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
NEXT_PUBLIC_REPO_URL=https://github.com/softalpha0/Errand
